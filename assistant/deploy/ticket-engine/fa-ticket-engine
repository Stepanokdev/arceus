#!/bin/bash
set -euo pipefail
NAME="$(basename "$0")"
[[ "$NAME" =~ ^fa-ticket-engine(-[a-z0-9]+)?$ ]] || { echo "bad desk name" >&2; exit 2; }
CONF=/etc/$NAME.conf
# shellcheck disable=SC1090
. "$CONF"
: "${ENGINE_USER:?}" "${WORKSPACE:?}" "${MIRROR:?}" "${ENGINE_BIN:?}" "${ASSISTANT_USER:?}"
as_engine() { sudo -n -u "$ENGINE_USER" -H env -C "$WORKSPACE" bash -lc 'set -a; . "$HOME/engine.conf"; [ -f "$HOME/engine.env" ] && . "$HOME/engine.env"; set +a; exec "$@"' _ "$@"; }
valid_id() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9-]{2,80}$ ]] || { echo "bad task id" >&2; exit 2; }; }

as_user() { sudo -n -u "$ENGINE_USER" -H "$@"; }
as_caller() { sudo -n -u "$ASSISTANT_USER" -H "$@"; }
pack_as_caller() {
  as_caller bash -c 'cd -- "$1" && find . \( -type d -o -type f \) -print0 | tar --null --no-recursion -cf - -T -' _ "$1"
}
unpack_as_engine() {
  as_user bash -c 'set -e; new="$1.new"; rm -rf -- "$new"; mkdir -p -- "$new"
                   tar -C "$new" --no-same-owner --no-same-permissions -xf -
                   rm -rf -- "$1"; mv -- "$new" "$1"' _ "$1"
}

case "${1:-}" in
  sync)
    as_caller test -d "$MIRROR" || { echo "no mirror" >&2; exit 2; }
    pack_as_caller "$MIRROR" | unpack_as_engine "$WORKSPACE/code"
    ;;
  dispatch)
    valid_id "${2:-}"
    [[ "${3:-}" == /* && "${4:-}" == /* ]] || { echo "task file and brief folder must be absolute paths" >&2; exit 2; }
    as_caller test -f "$3" && as_caller test -d "$4" || { echo "no task file or brief folder" >&2; exit 2; }
    text="$(as_caller cat -- "$3")"
    as_user mkdir -p "$WORKSPACE/briefs"
    pack_as_caller "$4" | unpack_as_engine "$WORKSPACE/briefs/$2"
    as_engine "$ENGINE_BIN/dispatch.sh" --task-id "$2" --message-id "$2" --source other --author assistant \
      --runspec "$ENGINE_HOME/ticket-runspec.json" --dirty fail "$WORKSPACE" "$text"
    ;;
  show)
    valid_id "${2:-}"; as_engine night-shift task show --task-id "$2" --json ;;
  artifact)
    valid_id "${2:-}"
    as_user test -f "$WORKSPACE/artifacts/$2.md" || exit 3
    as_user cat -- "$WORKSPACE/artifacts/$2.md" ;;
  status)
    as_engine night-shift doctor --server --json "$WORKSPACE" ;;
  *) echo "usage: fa-ticket-engine sync|dispatch <id> <task> <dir>|show <id>|artifact <id>|status" >&2; exit 2 ;;
esac
